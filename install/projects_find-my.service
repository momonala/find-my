[Unit]
Description=Find My dashboard and read-only API
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/home/mnalavadi/find-my
Type=idle
ExecStart=/home/mnalavadi/.local/bin/uv run findmy serve
User=mnalavadi

# The poller handles its own exceptions, so an exit means something it could
# not recover from.
Restart=always
RestartSec=10

# Backstop against the Anisette VM recycling in src/findmy/airtags.py failing, whose
# failure mode is accumulating VMs rather than a crash. Steady state is ~165 MB;
# hitting this means that recycling needs looking at. See "Why RAM saw-tooths"
# in README.md.
MemoryMax=300M

[Install]
WantedBy=multi-user.target
