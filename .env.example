# Copy to .env and customize for local development (CI uses these stub values as-is).
ICLOUD_USERNAME=
ICLOUD_PASSWORD=
# Optional: require this token in an X-Api-Token header on PUT /locations/<id>/icon.
# Leave blank for localhost-only use; set it before exposing the dashboard.
API_WRITE_TOKEN=
# Optional: push triggered alerts to a Telegram chat. Leave both blank to keep
# alerting in-app only. Create a bot via @BotFather for the token; the chat id
# is the destination chat/user/group id.
TELEGRAM_API_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: adds reliable MapTiler tile options to the map style picker.
# Leave blank to keep the free CARTO/OSM styles only. Free key from
# https://cloud.maptiler.com/account/keys/ (generous free tier).
MAPTILER_API_KEY=
